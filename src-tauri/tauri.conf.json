{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open FEM Studio",
  "version": "2026.39.2",
  "identifier": "org.openaec.fem-studio",
  "build": {
    "frontendDist": "../design-mockup/dist",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "cd design-mockup && npm run dev",
    "beforeBuildCommand": "cd design-mockup && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Open FEM Studio",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: https://*.tile.openstreetmap.org; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://nominatim.openstreetmap.org http://localhost:* ws://localhost:1440 ws://127.0.0.1:1440 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "app",
      "dmg"
    ],
    "windows": {
      "wix": {
        "version": "26.39.2"
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "resources": [
      "WebView2Loader.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OpenAEC Foundation",
    "copyright": "© 2026 OpenAEC Foundation. AGPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Eindige-elementenprogramma voor constructies (2D en 3D)",
    "longDescription": "Open FEM Studio — open-source eindige-elementenprogramma (2D en 3D) voor constructieve berekeningen en normtoetsing. Onderdeel van het portfolio van de OpenAEC Foundation."
  },
  "plugins": {}
}
